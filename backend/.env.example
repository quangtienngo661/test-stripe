# ============================================================================
#  OptiSigns Billing Demo — backend configuration
#  Copy file này thành `.env` rồi điền giá trị. File `.env` đã được gitignore.
# ============================================================================


# ---------------------------------------------------------------- SERVER ----

# Cổng của NestJS API. Frontend (Vite, cổng 5555) proxy /api về đây,
# nên đổi cổng này thì phải sửa luôn `frontend/vite.config.ts`.
PORT=3123

# URL của frontend. Dùng làm `return_url` khi mở Stripe Customer Portal và
# `success_url`/`cancel_url` của Checkout session (mode=setup).
FRONTEND_URL=http://localhost:5555


# --------------------------------------------------------------- MONGODB ----

# Chuỗi kết nối MongoDB. Theo yêu cầu demo, Mongo chạy ở cổng 27099:
#   mongod --port 27099 --dbpath ./.mongo-data
# App tự tạo các collection: accounts, catalog_items, billing_policies,
# billing_events. Không cần migration.
MONGO_URI=mongodb://127.0.0.1:27099/optisigns_billing_demo


# ----------------------------------------------------------------- STRIPE ----

# BẮT BUỘC. Secret key ở TEST MODE — luôn bắt đầu bằng `sk_test_`.
# Lấy tại: https://dashboard.stripe.com/test/apikeys  (mục "Secret key")
#
# App dùng key này cho toàn bộ thao tác server-side: tạo product/price, customer,
# subscription, prorate, subscription schedule, credit note, refund, test clock.
#
# ĐỪNG dùng key live (`sk_live_`): demo sẽ tạo/huỷ subscription và hoàn tiền thật.
# App coi giá trị kết thúc bằng "xxx" là chưa cấu hình.
STRIPE_SECRET_KEY=sk_test_xxx

# TUỲ CHỌN. Publishable key (`pk_test_`), cùng trang dashboard ở trên.
# Chỉ cần nếu sau này bạn muốn nhúng Stripe Elements để nhập thẻ ngay trong UI.
# Demo hiện tại gắn thẻ bằng payment method token test của Stripe
# (pm_card_visa, pm_card_chargeDeclined, ...) nên không bắt buộc.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# TUỲ CHỌN nhưng nên có. Signing secret của webhook (`whsec_`).
# Chạy: stripe listen --forward-to localhost:3123/api/webhooks/stripe
# CLI in ra whsec_... thì dán vào đây rồi restart backend.
#
# Có secret  -> app verify chữ ký (đúng như production).
# Chưa có    -> endpoint vẫn nhận payload không ký, tiện test local bằng curl.
#
# Webhook dùng để: đồng bộ ngược trạng thái subscription về Mongo, ghi nhật ký,
# và thực thi chính sách dunning khi invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_xxx


# --------------------------------------------------------------- BILLING ----

# Tiền tệ tạo Price trên Stripe và hiển thị trên UI (mã ISO viết thường).
# OptiSigns niêm yết USD/EUR/GBP/AUD/CAD. Lưu ý: đã sync catalog với một loại
# tiền rồi thì đổi sang loại khác cần chạy lại sync để tạo bộ Price mới.
CURRENCY=usd
